# Reinstalled fresh inside the image against the container's own OS/libc —
# copying the host's node_modules would ship Windows/glibc native binaries
# (Prisma's query engine, @node-rs/argon2) into a musl container that cannot
# load them.
node_modules
**/node_modules

# Rebuilt by `prisma generate` (postinstall) for the container's platform.
packages/db/generated

# Build output — regenerated by the image's own build stage.
.next
**/.next
dist
build
out

.git
.claude
*.tsbuildinfo
coverage
.vitest
*.log

# Secrets: never enter the build context. Runtime config comes from the
# container's environment (`docker run -e` / compose `environment:`), never
# from a baked-in file.
.env
.env.local
.env.*.local

.DS_Store
Thumbs.db
