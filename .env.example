# Copy to .env and fill in. NEVER commit .env.
# Every value here is read exactly once, by packages/env. Nothing else may touch process.env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Matches docker-compose.yml (non-default host ports, to avoid colliding with
# any Postgres/Redis you already run locally).
DATABASE_URL=postgresql://fluid:fluid_dev_password@localhost:5433/fluid
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Crypto
# ---------------------------------------------------------------------------
# Key-encryption key for the token vault (OAuth refresh tokens, BYO AI keys).
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this without re-wrapping stored DEKs makes every secret unreadable.
ENCRYPTION_KEK=

# ---------------------------------------------------------------------------
# Google Calendar (optional — the app runs without it, you just can't sync)
# ---------------------------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS URL for Google push notifications. Localhost will NOT work —
# use a tunnel (cloudflared / ngrok). Leave blank to fall back to polling.
GOOGLE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# AI (optional — with no key the app uses the deterministic scheduler only)
# ---------------------------------------------------------------------------
# Server-side default. Users may also bring their own key in Settings.
ANTHROPIC_API_KEY=
# Hard kill switch: set to 1 to disable every AI code path, for testing the
# deterministic fallback.
AI_DISABLED=0

# Permit a CalDAV server on localhost — for testing against one you run
# yourself (Radicale, Baikal). Leave off in production: the SSRF guard exists to
# stop a URL someone typed from reaching the machine the server runs on.
CALDAV_ALLOW_LOCALHOST=0
